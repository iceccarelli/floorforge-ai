@@ -814,3 +814,35 @@ textarea:focus-visible,
   outline: 2px solid var(--accent);
   outline-offset: 2px;
 }
+
+/* ---- Print: only the active estimator view goes on paper -------------------
+   The worksheet shows crew hours at cost, the blended labour rate and the
+   margin. Handing that to a homeowner shows them your markup, and before the
+   proposal view existed that was one button-press away. `hidden` already
+   removes the inactive view from the a11y tree; this makes sure the browser's
+   print renderer agrees, and strips the page chrome so the sheet lands on the
+   paper alone. */
+@media print {
+  [data-print-view][hidden] {
+    display: none !important;
+  }
+  header,
+  footer,
+  .chat-launcher,
+  .chatbot-panel,
+  .skip-link {
+    display: none !important;
+  }
+  .proposal-sheet,
+  #estimate-sheet {
+    border: 0 !important;
+    box-shadow: none !important;
+    padding: 0 !important;
+  }
+  body {
+    background: #fff !important;
+  }
+  a[href]::after {
+    content: "";
+  }
+}
