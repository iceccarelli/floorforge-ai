-diff --git a/lib/db/configured.ts b/lib/db/configured.ts
-new file mode 100644
-index 0000000..1e77d3d
---- /dev/null
-+++ b/lib/db/configured.ts
-@@ -0,0 +1,84 @@
-+import { NextResponse } from "next/server";
-+
-+/**
-+ * Is the database actually wired up?
-+ *
-+ * WHY THIS EXISTS. lib/db/client.ts already knew the answer — it logs a warning
-+ * at module load when the credentials are absent — and then did nothing with
-+ * it. It substituted a placeholder host, `https://example.supabase.co`, and let
-+ * every request go out to a domain FloorForge does not own. The request fails
-+ * with `TypeError: fetch failed`, and five API route files turn that into:
-+ *
-+ *     500  {"error":{"code":"INTERNAL_SERVER_ERROR",
-+ *           "message":"Failed to fetch pilot applications: TypeError: fetch failed"}}
-+ *
-+ * Three things are wrong with that, in increasing order of how much they cost.
-+ *
-+ * 1. A CONFIGURATION STATE IS REPORTED AS A SERVER FAULT. 500 means the server
-+ *    broke. Missing credentials on a pre-launch site is not a fault; it is the
-+ *    expected state, and it has a status code of its own — 503, the service is
-+ *    not available yet.
-+ *
-+ * 2. THE INTERNAL EXCEPTION TEXT IS RETURNED TO THE CALLER. Nine handlers echo
-+ *    `error.message` into the response body. Today that string is harmless.
-+ *    The day it contains a hostname, a table name or a connection detail, it is
-+ *    not, and nobody will have changed anything for it to become a leak.
-+ *
-+ * 3. THE EXPENSIVE ONE. When the credentials ARE set, a genuine Supabase outage
-+ *    produces the identical 500, the identical message and the identical log
-+ *    line as today's expected no-credentials state. The signal everyone has
-+ *    already learned to scroll past becomes indistinguishable from "the pilot
-+ *    pipeline is down and leads are being lost right now". That is how an
-+ *    outage runs for days before anyone notices.
-+ *
-+ * So: not-configured becomes a first-class, distinguishable state. It never
-+ * reaches the network, it never throws, it returns a status that means what it
-+ * says, and it carries a code a monitor can alert on separately from a fault.
-+ */
-+export const DATABASE_CONFIGURED = Boolean(
-+  process.env.NEXT_PUBLIC_SUPABASE_URL && process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY
-+);
-+
-+/** The distinct code. A monitor can page on FAULT and ignore this one. */
-+export const NOT_CONFIGURED_CODE = "DATABASE_NOT_CONFIGURED";
-+
-+/**
-+ * 503 with an honest body. Returned BEFORE any query is attempted, so no
-+ * request leaves for a host nobody owns and no stack trace is generated for a
-+ * condition that is not an error.
-+ */
-+export function databaseNotConfigured() {
-+  return NextResponse.json(
-+    {
-+      error: {
-+        code: NOT_CONFIGURED_CODE,
-+        message:
-+          "The FloorForge database is not configured on this deployment. This endpoint is part of the pilot backend and is not available yet. No data was read or written.",
-+      },
-+    },
-+    {
-+      status: 503,
-+      // Tells a well-behaved client this is not permanent and not its fault.
-+      headers: { "Retry-After": "3600", "Cache-Control": "no-store" },
-+    }
-+  );
-+}
-+
-+/**
-+ * A fault, reported without handing the caller our internals.
-+ *
-+ * The real error still reaches the server log in full — this changes what the
-+ * CLIENT is told, not what an operator can debug with.
-+ */
-+export function internalError(where: string, error: unknown) {
-+  console.error(`${where}:`, error);
-+  return NextResponse.json(
-+    {
-+      error: {
-+        code: "INTERNAL_SERVER_ERROR",
-+        message: "The request could not be completed. The failure has been logged.",
-+      },
-+    },
-+    { status: 500 }
-+  );
-+}
