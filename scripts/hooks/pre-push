#!/usr/bin/env bash
# FloorForge pre-push guard. Install with: scripts/hooks/install.sh
#
# Runs the same verification GitHub Actions runs, so a red build is caught
# before it is pushed — and so verification still works when Actions is down.
# It has been.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "▸ pre-push guards"

node scripts/check-repo-hygiene.mjs
node audit/scripts/parse-check.mjs 2>/dev/null || {
  echo "  (audit/scripts/parse-check.mjs not present — skipping AST gate)"
}

echo "  running tsc…"
test -x node_modules/.bin/tsc || { echo "  node_modules is missing or incomplete — run: npm ci"; exit 1; }
node_modules/.bin/tsc --noEmit

echo "  running lint…"
npm run lint

# Next 16 takes a lock at .next/lock for the duration of a build and removes it
# on clean exit. A build that was interrupted — Ctrl-C, a killed background job,
# a crashed terminal — leaves it behind, and the next build fails with
# "Another next build process is already running". Surfacing that as a PUSH
# failure is how guards teach people to reach for --no-verify, so handle it:
# if no next process is actually running, the lock is stale. Say so, clear it,
# continue.
if [ -e .next/lock ] && ! pgrep -f "next build" >/dev/null 2>&1; then
  echo "  clearing a stale .next/lock (no build is running)"
  rm -f .next/lock
fi

echo "  running build…"
npm run build --silent >/dev/null

echo "✓ guards passed — pushing"
