+/* Visually hidden, still in the accessibility tree and still in the DOM for a
+   crawler. NOT `display:none` — that removes it from both. Tailwind ships an
+   `sr-only` utility, but this is a layered utility and several places here need
+   it to win against unlayered component CSS, so it is declared once. */
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
 /* Accessibility & focus */
 button:focus-visible,
 a:focus-visible,
