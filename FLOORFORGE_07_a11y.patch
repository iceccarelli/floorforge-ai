+/* ---------------------------------------------------------------------------
+   RANGE CONTROL — the ROI sliders, and the simulator's.
+
+   A native range input is ~16px tall, which is a quarter of the 44px WCAG 2.2
+   AA 2.5.8 target and the single worst control to hand someone one-handed on a
+   job site (audit/FINDINGS.md P0-4, P1-5). The track stays visually thin; the
+   HIT AREA is grown with padding, and the thumb is sized to the floor.
+   --------------------------------------------------------------------------- */
+.range-control {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 100%;
+  min-height: var(--tap-min);
+  padding: 0;
+  background: transparent;
+  cursor: pointer;
+  touch-action: manipulation;
