+.range-control::-moz-range-thumb {
+  height: 28px;
+  width: 28px;
+  border: 2px solid var(--primary-foreground);
+  border-radius: var(--r-full);
+  background: var(--accent);
+  box-shadow: var(--elev-card-hover);
+  transition: transform var(--duration-fast) var(--ease-std);
+}
+
+.range-control:active::-webkit-slider-thumb { transform: scale(1.08); }
+.range-control:active::-moz-range-thumb { transform: scale(1.08); }
+
+.range-control:focus-visible {
