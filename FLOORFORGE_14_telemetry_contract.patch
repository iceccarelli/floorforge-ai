   | "pass_started"
   | "pass_completed"
   | "dust_reading"
+  | "error"
+  // Firmware contract only — raw sensor stream, 1 Hz
+  | "pressure_reading"
+  | "coverage_checkpoint"
+  | "job_paused"
+  | "job_resumed"
+  // Platform only — derived and workflow events
   | "coverage_check"
   | "robot_paused"
   | "robot_resumed"
   | "finish_applied"
   | "quality_approved"
   | "quality_failed"
-  | "error"
   | "heartbeat";
 
