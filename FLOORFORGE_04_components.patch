+  /* -------------------------------------------------------------------------
+     STATUS — job and application state in the operator console.
+
+     Reserved: a status colour never doubles as decoration, and it never carries
+     meaning alone — every pill contains its own label. Each ink/tint pair was
+     measured, not picked; all clear 4.5:1. The tints sit close to white on
+     purpose (1.07-1.22:1), so the pill takes a border to have a shape.
+
+     Before FLOORFORGE_04_components.patch these were raw Tailwind palette
+     classes — bg-blue-100 text-blue-800 and friends — in a console whose
+     primary action colour was bg-blue-600 on a site whose accent is amber.
+     ------------------------------------------------------------------------- */
+  --status-neutral-ink: #334155;  --status-neutral-tint: #f1f5f9;  /* 9.45:1 */
