# All variables are OPTIONAL. The site builds and deploys with none of them.

# Clerk (enables Sign in + protected /dashboard when BOTH are set)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (future production data layer; unused by the demo dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Formspree form ID for the pilot waitlist form (e.g. abcdwxyz).
# Without it, the waitlist CTA falls back to a mailto link.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# ---------------------------------------------------------------------------
# Telemetry ingest (server-side only)
# ---------------------------------------------------------------------------
# Required for POST /api/telemetry and GET /api/telemetry/resume. Without it
# both return 503 TELEMETRY_NOT_CONFIGURED — a clear refusal, not a silent
# write to a placeholder project.
#
# NO NEXT_PUBLIC_ PREFIX, EVER. This key bypasses Row Level Security. Prefixing
# it would inline it into the browser bundle and hand every visitor full read
# and write access to every tenant. lib/db/service.ts throws if it is evaluated
# in a browser, so an accidental client import fails loudly rather than shipping.
SUPABASE_SERVICE_ROLE_KEY=
